@page "/assessments"


@using System.Net
@using System.Net.Http.Json
@using ADA.Frontend.Services
@using ADA.Frontend.Components.Buttons
@using ADA.Frontend.Components.Messages

@inject IHttpClientFactory HttpClientFactory
@inject AuthSession AuthSession
@inject NavigationManager Navigation

<!-- Header -->
<div class="mb-4 d-flex justify-content-between align-items-center">
    <BackToDashboardButton />
    <LogoutButton />
</div>

<PageTitle>Manage Assessments</PageTitle>

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Manage Assessments</h2>
            <p class="text-muted">
                View and manage your created assessments.
            </p>
        </div>

        <button class="btn btn-primary"
                @onclick="GoToCreateAssessment">
            <i class="bi bi-plus-lg me-1"></i>
            Create Assessment
        </button>
    </div>

    <MessagePopup Message="@message"
                  Success="@success"
                  OnClose="CloseMessage" />

    <MessagePopup Message="@deleteMessage"
                  Confirmation="true"
                  OnClose="CancelDelete"
                  OnConfirm="ConfirmDelete" />

    @if (!AuthSession.IsAuthenticated)
    {
        <div class="alert alert-warning">
            Please <a href="/login">log in</a> first.
        </div>
    }
    else if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="text-muted mt-2">Loading assessments...</p>
        </div>
    }
    else if (assessments.Count == 0)
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-clipboard2 display-4 text-muted"></i>
                <h5 class="mt-3">No assessments found</h5>
                <p class="text-muted">
                    You haven't created any assessments yet.
                </p>

                <button class="btn btn-primary"
                        @onclick="GoToCreateAssessment">
                    Create your first assessment
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">

                <div class="d-flex justify-content-between mb-3">
                    <h5 class="mb-0">Your Assessments</h5>
                    <span class="badge bg-secondary">
                        @assessments.Count assessments
                    </span>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Assessment Name</th>
                                <th>Application</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var assessment in assessments)
                            {
                                <tr @key="assessment.AssessmentId">
                                    <td>
                                        <strong>
                                            @assessment.AssessmentName
                                        </strong>
                                    </td>

                                    <td>
                                        @assessment.ApplicationName
                                    </td>

                                    <td>
                                        @assessment.StartDate.ToString("dd-MM-yyyy")
                                    </td>

                                    <td>
                                        @assessment.EndDate.ToString("dd-MM-yyyy")
                                    </td>
                                    <td>
                                        <button class="btn btn-outline-primary btn-sm"
                                                @onclick="() => GoToEditAssessment(assessment.AssessmentId)">
                                            <i class="bi bi-pencil me-1"></i>
                                            
                                        </button>
                                        <button class="btn btn-outline-danger btn-sm ms-1"
                                                 @onclick="() => AskToDelete(assessment.AssessmentId)">
                                            <i class="bi bi-trash me-1"></i>
                                                
                                        </button>

                                             @if (assessmentToDelete == assessment.AssessmentId)
                                             {
                                                 <div class="mt-2">
                                                    <span class="text-danger">
                                                         Are you sure you want to delete this assessment?
                                                    </span>

                                        <div class="mt-2">
                                          <button class="btn btn-danger btn-sm"
                                             disabled="@isDeleting"
                                             @onclick="ConfirmDelete">
                                             @(isDeleting ? "Deleting..." : "Yes, delete")
                                         </button>

                                            <button class="btn btn-secondary btn-sm ms-1"
                                              disabled="@isDeleting"
                                                @onclick="CancelDelete">
                                                 Cancel
                                            </button>
                                        </div>
                                       </div>
                                              }
                                    </td>
                                   
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    }
</div>

@code {
    private List<AssessmentResponse> assessments = new();

    private bool isLoading = true;
    private bool success;
    private string message = "";
    private string deleteMessage = "";
    private Guid? assessmentToDelete;
    private bool isDeleting;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthSession.IsAuthenticated)
        {
            isLoading = false;
            return;
        }

        await LoadAssessments();
    }

    private async Task LoadAssessments()
    {
        isLoading = true;
        message = "";

        try
        {
            var client = HttpClientFactory.CreateClient("ADAApi");

            using var request = new HttpRequestMessage(
                HttpMethod.Get,
                "api/assessments");

            AddSessionCookie(request);

            using var response = await client.SendAsync(request);

            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                message = "Your session has expired. Please log in again.";
                return;
            }

            if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                message = "You don't have permission to view assessments.";
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();

                message = $"API error ({(int)response.StatusCode}): {error}";
                return;
            }

            assessments = await response.Content
                .ReadFromJsonAsync<List<AssessmentResponse>>() ?? new();

            assessments = assessments
            .OrderByDescending(a => a.StartDate)
            .ToList();
        }
        catch (Exception ex)
        {
            message = $"Could not load assessments: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void AddSessionCookie(HttpRequestMessage request)
    {
        if (!string.IsNullOrWhiteSpace(AuthSession.CookieHeader))
        {
            request.Headers.TryAddWithoutValidation(
                "Cookie",
                AuthSession.CookieHeader);
        }
    }

    private void GoToCreateAssessment()
    {
        Navigation.NavigateTo("/assessments/create");
    }

    private void CloseMessage()
    {
        message = "";
    }

    private void GoToEditAssessment(Guid assessmentId)
    {
        Navigation.NavigateTo($"/assessments/edit/{assessmentId}");
    }

    private void AskToDelete(Guid assessmentId)
    {
        assessmentToDelete = assessmentId;
        deleteMessage = "Are you sure you want to delete this assessment? This action cannot be undone.";
    }

    private void CancelDelete()
    {
        assessmentToDelete = null;
        deleteMessage = "";
    }

    private async Task ConfirmDelete()
    {
        if (assessmentToDelete == null)
            return;

        if (string.IsNullOrWhiteSpace(AuthSession.CsrfToken))
        {
            message = "Your security token is missing. Please log in again.";
            success = false;
            return;
        }

        isDeleting = true;
        message = "";
        success = false;
        deleteMessage = "";

        try
        {
            var client = HttpClientFactory.CreateClient("ADAApi");

            using var request = new HttpRequestMessage(
                HttpMethod.Delete,
                $"api/assessments/{assessmentToDelete}");

            // Send authentication cookie.
            AddSessionCookie(request);

            // Send CSRF token.
            request.Headers.Add(
                "X-CSRF-TOKEN",
                AuthSession.CsrfToken);

            using var response = await client.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                assessmentToDelete = null;

                // Reload the assessment list.
                await LoadAssessments();

                success = true;
                message = "Assessment deleted successfully!";
            }
            else if (response.StatusCode == HttpStatusCode.Conflict)
            {
                message = "This assessment cannot be deleted because respondents have already submitted answers.";
            }
            else if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                message = "Your session has expired. Please log in again.";
            }
            else if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                message = "You need the Admin role to delete assessments.";
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                message = $"Could not delete assessment: {error}";
            }
        }
        catch (Exception ex)
        {
            message = $"Error deleting assessment: {ex.Message}";
        }
        finally
        {
            isDeleting = false;
        }
    }
    // Matches the response DTO from the backend GetAssessment query.
    private class AssessmentResponse
    {
        public Guid AssessmentId { get; set; }

        public string AssessmentName { get; set; } = "";

        public string ApplicationName { get; set; } = "";

        public DateTime StartDate { get; set; }

        public DateTime EndDate { get; set; }
    }
}
