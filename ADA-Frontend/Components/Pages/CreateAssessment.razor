@page "/assessments/create"
@rendermode InteractiveServer

@using System.Net.Http.Json
@using ADA.Frontend.Services
@using ADA.Frontend.Components.Buttons
@using ADA.Frontend.Components.Messages

@inject IHttpClientFactory HttpClientFactory
@inject AuthSession AuthSession

<!-- Header -->
<div class="mb-4 d-flex justify-content-between align-items-center">
   
    <BackToDashboardButton />
    <LogoutButton />
</div>

<PageTitle>Create Assessment</PageTitle>

<div class="container py-4">

    <h2>Create Assessment</h2>
   
    <p class="text-muted">
        Create a new ADA assessment.
    </p>

   <MessagePopup Message="@message"
              Success="@success"
              OnClose="CloseMessage" />

    @if (!AuthSession.IsAuthenticated)
    {
        <div class="alert alert-warning">
            Please <a href="/login">log in</a> first.
        </div>
    }
    else
    {
  <div class="row g-4 align-items-start">
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-body">

                <div class="mb-3">
                    <label class="form-label">Assessment Name</label>
                    <input class="form-control"
                           @bind="assessmentName"
                           placeholder="e.g. Employee Assessment 2026" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Application Name</label>
                    <input class="form-control"
                           @bind="applicationName"
                           placeholder="e.g. Microsoft Teams" />
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Start Date</label>
                        <input type="date"
                               class="form-control"
                               @bind="startDate" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">End Date</label>
                        <input type="date"
                               class="form-control"
                               @bind="endDate" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Roles</label>
                    <input class="form-control"
                           @bind="roleNames"
                           @bind:after="LoadRecipientPreviewAsync"
                           disabled="@(isLoadingRecipientPreview || isSaving)"
                           placeholder="Developer, Manager, Consultant" />
                    <small class="text-muted">
                        Separate roles with commas.
                    </small>
                </div>

                <hr />

                <h5>Regions</h5>

                @foreach (var region in regions)
                {
                    <div class="form-check" @key="region.RegionId">
                        <input type="checkbox"
                             class="form-check-input"
                             @bind="region.Selected"
                             @bind:after="LoadRecipientPreviewAsync"
                             disabled="@(isLoadingRecipientPreview || isSaving)" />
                        <label class="form-check-label">
                            @region.RegionName
                        </label>
                    </div>
                }

                <hr />

                <h5>Experience Levels</h5>

                @foreach (var experience in experiences)
                {
                    <div class="form-check" @key="experience.ExperienceId">
                        <input type="checkbox"
                               class="form-check-input"
                               @bind="experience.Selected" />
                        <label class="form-check-label">
                            @experience.ExperienceValue
                        </label>
                    </div>
                }

                <button class="btn btn-primary"
                        disabled="@(isSaving || isLoadingRecipientPreview)"
                        @onclick="HandleCreateAssessment">
                    @(isSaving ? "Creating..." : "Create Assessment")
                </button>

                <a href="/dashboard"
                   class="btn btn-outline-secondary ms-2">
                    Cancel
                </a>

            </div>
        </div>
      </div>

            <aside class="col-lg-5" aria-labelledby="recipients-heading">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 id="recipients-heading">Recipients</h5>
                        @if (isLoadingRecipientPreview)
                        {
                            <p role="status">Loading recipients…</p>
                        }
                        else if (recipientPreviewError is not null)
                        {
                            <p class="text-danger" role="alert">@recipientPreviewError</p>
                        }
                        else if (recipientPreview is { } preview)
                        {
                            <p role="status">@preview.TotalCount matching contacts</p>

                            @if (preview.Recipients.Count > 0)
                            {
                                <ul>
                                    @foreach (var recipient in preview.Recipients)
                                    {
                                        <li class="text-break">@recipient.Email</li>
                                    }
                                </ul>
                            }

                            @if (preview.TotalCount > preview.Recipients.Count)
                            {
                                <p class="text-warning">
                                    Showing @preview.Recipients.Count of @preview.TotalCount matches.
                                    Narrow the filters before creating the assessment.
                                </p>
                            }
                        }
                        else
                        {
                            <p class="text-muted">Enter a role or select a region to see matching contacts.</p>
                        }
                        <textarea id="manual-recipient-emails"
                                  class="form-control"
                                  rows="4"
                                  @bind="respondentEmails"
                                  disabled="@isSaving"></textarea>
                        <small class="text-muted">One email per line.</small>
                    </div>
                </div>
            </aside>

    </div>
    }
</div>

@code {

    private string assessmentName = "";
    private string applicationName = "";
    private string roleNames = "";
    private string respondentEmails = "";

    private DateTime startDate = DateTime.Today;
    private DateTime endDate = DateTime.Today.AddDays(14);

    private List<RegionOption> regions = new();
    private List<ExperienceOption> experiences = new();

    private string message = "";
    private bool success;
    private bool isSaving;

    
    private RecipientPreviewResponse? recipientPreview;
    private string? recipientPreviewError;
    private bool isLoadingRecipientPreview;

    private static readonly Guid SurveyId =
        Guid.Parse("22222222-2222-2222-2222-222222222222");


    // Load regions and experience levels.
    protected override async Task OnInitializedAsync()
    {
        if (!AuthSession.IsAuthenticated)
            return;

        try
        {
            var client = HttpClientFactory.CreateClient("ADAApi");

            // Load regions using the authentication cookie.
            using var regionRequest =
                new HttpRequestMessage(HttpMethod.Get, "api/regions");

            AddSessionCookie(regionRequest);

            using var regionResponse =
                await client.SendAsync(regionRequest);

            if (regionResponse.StatusCode ==
                System.Net.HttpStatusCode.Unauthorized)
            {
                message = "Your session has expired. Please log in again.";
                return;
            }

            regionResponse.EnsureSuccessStatusCode();

            regions = await regionResponse.Content
                .ReadFromJsonAsync<List<RegionOption>>() ?? new();


            // Load experience levels using the authentication cookie.
            using var experienceRequest =
                new HttpRequestMessage(HttpMethod.Get, "api/experiences");

            AddSessionCookie(experienceRequest);

            using var experienceResponse =
                await client.SendAsync(experienceRequest);

            if (experienceResponse.StatusCode ==
                System.Net.HttpStatusCode.Unauthorized)
            {
                message = "Your session has expired. Please log in again.";
                return;
            }

            experienceResponse.EnsureSuccessStatusCode();

            experiences = await experienceResponse.Content
                .ReadFromJsonAsync<List<ExperienceOption>>() ?? new();
        }
        catch (Exception ex)
        {
            message = $"Could not load options: {ex.Message}";
        }
    }


    private async Task LoadRecipientPreviewAsync()
    {
        if (isLoadingRecipientPreview || isSaving)
        {
            return;
        }

        ClearRecipientPreview();

        

        // Brug de samme valgte regioner og roller som ved oprettelse af målingen.
        var selectedRegionIds = regions
            .Where(region => region.Selected)
            .Select(region => region.RegionId)
            .ToArray();

        var selectedRoleNames = SplitValues(roleNames);

        if (selectedRegionIds.Length == 0 && selectedRoleNames.Count == 0)
        {
            recipientPreviewError = "Select a region or enter a role to preview recipients.";
            return;
        }

        if (!AuthSession.IsAuthenticated ||
            string.IsNullOrWhiteSpace(AuthSession.CsrfToken))
        {
            recipientPreviewError = "Please log in again to preview recipients.";
            return;
        }

        isLoadingRecipientPreview = true;

        try
        {
            using var client = HttpClientFactory.CreateClient("ADAApi");
            using var request = new HttpRequestMessage(
                HttpMethod.Post, "api/assessments/recipients/preview");

            // Send cookie og CSRF-token på samme måde som ved oprettelse.
            AddSessionCookie(request);
            request.Headers.Add("X-CSRF-TOKEN", AuthSession.CsrfToken);
            request.Content = JsonContent.Create(new
            {
                regionIds = selectedRegionIds,
                roleNames = selectedRoleNames
            });

            using var response = await client.SendAsync(request);

            if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
            {
                var error = await response.Content.ReadFromJsonAsync<RecipientPreviewError>();
                recipientPreviewError = error?.Message ?? error?.Error
                    ?? "Check the selected regions and roles.";
                return;
            }

            response.EnsureSuccessStatusCode();
            recipientPreview = await response.Content
                .ReadFromJsonAsync<RecipientPreviewResponse>();

            if (recipientPreview is null)
            {
                recipientPreviewError = "The API returned no recipient preview.";
            }
        }
        catch (HttpRequestException)
        {
            recipientPreviewError = "Could not load the preview. Try again.";
        }
        catch (TaskCanceledException)
        {
            recipientPreviewError = "The preview request timed out. Try again.";
        }
        catch (System.Text.Json.JsonException)
        {
            recipientPreviewError = "The API returned a preview the page could not read.";
        }
        finally
        {
            isLoadingRecipientPreview = false;
        }
    }


    // Create a new assessment.
    private async Task HandleCreateAssessment()
    {
        message = "";
        success = false;

        if (!AuthSession.IsAuthenticated)
        {
            message = "Please log in first.";
            return;
        }

        if (string.IsNullOrWhiteSpace(assessmentName) ||
            string.IsNullOrWhiteSpace(applicationName))
        {
            message = "Enter an assessment name and application name.";
            return;
        }

        if (endDate <= startDate)
        {
            message = "End date must be after start date.";
            return;
        }

        var roles = SplitValues(roleNames);

        var selectedRegions = regions
            .Where(r => r.Selected)
            .Select(r => r.RegionId)
            .ToList();

        var selectedExperiences = experiences
            .Where(e => e.Selected)
            .Select(e => e.ExperienceId)
            .ToList();

        if (roles.Count == 0 ||
            selectedRegions.Count == 0 ||
            selectedExperiences.Count == 0)
        {
            message = "Choose at least one role, region and experience level.";
            return;
        }

        // CSRF token is required for the POST request.
        if (string.IsNullOrWhiteSpace(AuthSession.CsrfToken))
        {
            message = "Your security token is missing. Please log in again.";
            return;
        }

        // Modtagerlisten skal svare til den komplette forhåndsvisning.
        if (isLoadingRecipientPreview ||
            recipientPreview is not { } preview ||
            preview.TotalCount != preview.Recipients.Count)
        {
            message = "Wait for a complete recipient preview or narrow the filters.";
            return;
        }

        // Saml kontaktlisten og de manuelle adresser uden dubletter.
        var emails = SplitValues(respondentEmails)
            .Concat(preview.Recipients.Select(recipient => recipient.Email))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        var payload = new
        {
            AssessmentName = assessmentName,
            ApplicationName = applicationName,

            StartDate = DateTime.SpecifyKind(
                startDate.Date, DateTimeKind.Utc),

            EndDate = DateTime.SpecifyKind(
                endDate.Date, DateTimeKind.Utc),

            SurveyId = SurveyId,
            RoleNames = roles,
            RegionIds = selectedRegions,
            ExperienceIds = selectedExperiences,
            RespondentEmails = emails
        };

        isSaving = true;

        try
        {
            var client = HttpClientFactory.CreateClient("ADAApi");

            using var request = new HttpRequestMessage(
                HttpMethod.Post, "api/assessments");



            // Send the authentication cookie.
            AddSessionCookie(request);

            // Send the CSRF token.
            request.Headers.Add(
                "X-CSRF-TOKEN",
                AuthSession.CsrfToken);

            request.Content = JsonContent.Create(payload);

            using var response = await client.SendAsync(request);

            // Save any updated cookies from the response.
            UpdateCookies(response);

            if (response.IsSuccessStatusCode)
            {
                var id = await response.Content.ReadFromJsonAsync<Guid>();

                success = true;
                message = $"Assessment created successfully! ID: {id}";

                ClearForm();
            }
            else if (response.StatusCode ==
                     System.Net.HttpStatusCode.Forbidden)
            {
                message = "You need the Admin role to create assessments.";
            }
            else if (response.StatusCode ==
                     System.Net.HttpStatusCode.Unauthorized)
            {
                message = "Your session has expired. Please log in again.";
            }
            else if (response.StatusCode ==
                     System.Net.HttpStatusCode.BadRequest)
            {
                var error = await response.Content.ReadAsStringAsync();
                message = $"Request rejected: {error}";
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                message = $"API error ({(int)response.StatusCode}): {error}";
            }
        }
        catch (Exception ex)
        {
            message = $"Error: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ClearForm()
    {
        // Text fields
        assessmentName = "";
        applicationName = "";
        roleNames = "";
        respondentEmails = "";

        // Reset dates
        startDate = DateTime.Today;
        endDate = DateTime.Today.AddDays(14);

        // Unselect all regions
        foreach (var region in regions)
        {
            region.Selected = false;
        }

        // Unselect all experience levels
        foreach (var experience in experiences)
        {
            experience.Selected = false;
        }

        ClearRecipientPreview();
    }

    

    private void ClearRecipientPreview()
    {
        // En ny region eller rolle gør den tidligere forhåndsvisning ugyldig.
        recipientPreview = null;
        recipientPreviewError = null;
    }

    // Attach the stored authentication cookie to a request.
    private void AddSessionCookie(HttpRequestMessage request)
    {
        if (!string.IsNullOrWhiteSpace(AuthSession.CookieHeader))
        {
            request.Headers.TryAddWithoutValidation(
                "Cookie",
                AuthSession.CookieHeader);
        }
    }


    // Update stored cookies if the backend sends new ones.
    private void UpdateCookies(HttpResponseMessage response)
    {
        if (!response.Headers.TryGetValues(
            "Set-Cookie", out var setCookieHeaders))
        {
            return;
        }

        var cookies = new Dictionary<string, string>(
            StringComparer.OrdinalIgnoreCase);

        // Keep previously received cookies.
        if (!string.IsNullOrWhiteSpace(AuthSession.CookieHeader))
        {
            foreach (var cookie in AuthSession.CookieHeader.Split(
                ';', StringSplitOptions.RemoveEmptyEntries))
            {
                var parts = cookie.Trim().Split('=', 2);

                if (parts.Length == 2)
                    cookies[parts[0]] = parts[1];
            }
        }

        // Update cookies from the latest response.
        foreach (var setCookie in setCookieHeaders)
        {
            var cookiePair = setCookie.Split(';', 2)[0].Trim();
            var parts = cookiePair.Split('=', 2);

            if (parts.Length == 2)
                cookies[parts[0]] = parts[1];
        }

        AuthSession.CookieHeader = string.Join(
            "; ",
            cookies.Select(cookie =>
                $"{cookie.Key}={cookie.Value}"));
    }


    private static List<string> SplitValues(string input)
    {
        return input.Split(
                new[] { ',', ';', '\n', '\r' },
                StringSplitOptions.RemoveEmptyEntries |
                StringSplitOptions.TrimEntries)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private sealed record RecipientPreviewRow(string? FullName, string Email);

    private sealed record RecipientPreviewResponse(
        int TotalCount, List<RecipientPreviewRow> Recipients);

    private sealed record RecipientPreviewError(string? Message, string? Error);

    private class RegionOption
    {
        public Guid RegionId { get; set; }
        public string RegionName { get; set; } = "";
        public bool Selected { get; set; }
    }

    private class ExperienceOption
    {
        public Guid ExperienceId { get; set; }
        public string ExperienceValue { get; set; } = "";
        public bool Selected { get; set; }
    }

    private void CloseMessage()
    {
        message = "";
    }
}