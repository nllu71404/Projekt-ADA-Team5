@page "/assessments/edit/{AssessmentId:guid}"


@using System.Net
@using System.Net.Http.Json
@using ADA.Frontend.Services
@using ADA.Frontend.Components.Buttons
@using ADA.Frontend.Components.Messages

@inject IHttpClientFactory HttpClientFactory
@inject AuthSession AuthSession
@inject NavigationManager Navigation

<!-- Header -->
<div class="mb-4 d-flex justify-content-between align-items-center">
    <BackToDashboardButton />
    <LogoutButton />
</div>

<PageTitle>Edit Assessment</PageTitle>

<div class="container py-4">

    <h2>Edit Assessment</h2>

    <p class="text-muted">
        Update the details of your ADA assessment.
    </p>

    <MessagePopup Message="@message"
                  Success="@success"
                  OnClose="CloseMessage" />

    @if (!AuthSession.IsAuthenticated)
    {
        <div class="alert alert-warning">
            Please <a href="/login">log in</a> first.
        </div>
    }
    else if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border" role="status"></div>
            <p class="mt-2">Loading assessment...</p>
        </div>
    }
    else if (assessmentNotFound)
    {
        <div class="alert alert-warning">
            The assessment could not be found.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">

                <div class="mb-3">
                    <label class="form-label">Assessment Name</label>
                    <input class="form-control"
                           @bind="assessmentName"
                           placeholder="e.g. Employee Assessment 2026" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Application Name</label>
                    <input class="form-control"
                           @bind="applicationName"
                           placeholder="e.g. Microsoft Teams" />
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Start Date</label>
                        <input type="date"
                               class="form-control"
                               @bind="startDate" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">End Date</label>
                        <input type="date"
                               class="form-control"
                               @bind="endDate" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Roles</label>
                    <input class="form-control"
                           @bind="roleNames"
                           placeholder="Developer, Manager, Consultant" />
                    <small class="text-muted">
                        Separate roles with commas.
                    </small>
                </div>

                <hr />

                <h5>Regions</h5>

                @foreach (var region in regions)
                {
                    <div class="form-check" @key="region.RegionId">
                        <input type="checkbox"
                               class="form-check-input"
                               @bind="region.Selected" />
                        <label class="form-check-label">
                            @region.RegionName
                        </label>
                    </div>
                }

                <hr />

                <h5>Experience Levels</h5>

                @foreach (var experience in experiences)
                {
                    <div class="form-check" @key="experience.ExperienceId">
                        <input type="checkbox"
                               class="form-check-input"
                               @bind="experience.Selected" />
                        <label class="form-check-label">
                            @experience.ExperienceValue
                        </label>
                    </div>
                }

                <hr />

                <div class="mb-3">
                    <label class="form-label">Respondent Emails</label>
                    <textarea class="form-control"
                              rows="4"
                              @bind="respondentEmails"
                              placeholder="person1@example.com&#10;person2@example.com">
                    </textarea>
                    <small class="text-muted">
                        One email per line.
                    </small>
                </div>

                <button class="btn btn-primary"
                        disabled="@isSaving"
                        @onclick="HandleUpdateAssessment">
                    @(isSaving ? "Saving..." : "Save Changes")
                </button>

                <button class="btn btn-outline-secondary ms-2"
                        disabled="@isSaving"
                        @onclick="GoBack">
                    Cancel
                </button>

            </div>
        </div>
    }
</div>

@code {

    [Parameter]
    public Guid AssessmentId { get; set; }

    private string assessmentName = "";
    private string applicationName = "";
    private string roleNames = "";
    private string respondentEmails = "";

    private DateTime startDate = DateTime.Today;
    private DateTime endDate = DateTime.Today.AddDays(14);

    private List<RegionOption> regions = new();
    private List<ExperienceOption> experiences = new();

    private string message = "";
    private bool success;
    private bool isLoading = true;
    private bool isSaving;
    private bool assessmentNotFound;


    // Load the assessment and its available options.
    protected override async Task OnInitializedAsync()
    {
        if (!AuthSession.IsAuthenticated)
        {
            isLoading = false;
            return;
        }

        await LoadOptions();
        await LoadAssessment();

        isLoading = false;
    }


    // Load available regions and experience levels.
    private async Task LoadOptions()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("ADAApi");

            using var regionRequest =
                new HttpRequestMessage(HttpMethod.Get, "api/regions");

            AddSessionCookie(regionRequest);

            using var regionResponse =
                await client.SendAsync(regionRequest);

            if (!regionResponse.IsSuccessStatusCode)
            {
                message = "Could not load regions.";
                return;
            }

            regions = await regionResponse.Content
                .ReadFromJsonAsync<List<RegionOption>>() ?? new();


            using var experienceRequest =
                new HttpRequestMessage(HttpMethod.Get, "api/experiences");

            AddSessionCookie(experienceRequest);

            using var experienceResponse =
                await client.SendAsync(experienceRequest);

            if (!experienceResponse.IsSuccessStatusCode)
            {
                message = "Could not load experience levels.";
                return;
            }

            experiences = await experienceResponse.Content
                .ReadFromJsonAsync<List<ExperienceOption>>() ?? new();
        }
        catch (Exception ex)
        {
            message = $"Could not load options: {ex.Message}";
        }
    }


    // Load the existing assessment.
    private async Task LoadAssessment()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("ADAApi");

            using var request = new HttpRequestMessage(
                HttpMethod.Get,
                $"api/assessments/{AssessmentId}");

            AddSessionCookie(request);

            using var response = await client.SendAsync(request);

            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                message = "Your session has expired. Please log in again.";
                return;
            }

            if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                message = "You do not have permission to edit assessments.";
                return;
            }

            if (response.StatusCode == HttpStatusCode.NotFound ||
                response.StatusCode == HttpStatusCode.BadRequest)
            {
                assessmentNotFound = true;
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                message = $"API error ({(int)response.StatusCode}): {error}";
                return;
            }

            var assessment = await response.Content
                .ReadFromJsonAsync<AssessmentDetailsResponse>();

            if (assessment == null)
            {
                assessmentNotFound = true;
                return;
            }

            // Fill in the text fields.
            assessmentName = assessment.AssessmentName;
            applicationName = assessment.ApplicationName;

            roleNames = string.Join(", ", assessment.RoleNames);
            respondentEmails = string.Join(
                Environment.NewLine,
                assessment.RespondentEmails);

            // Fill in the dates.
            startDate = assessment.StartDate.Date;
            endDate = assessment.EndDate.Date;

            // Select the regions already connected to the assessment.
            foreach (var region in regions)
            {
                region.Selected = assessment.RegionIds
                    .Contains(region.RegionId);
            }

            // Select the experience levels already connected.
            foreach (var experience in experiences)
            {
                experience.Selected = assessment.ExperienceIds
                    .Contains(experience.ExperienceId);
            }
        }
        catch (Exception ex)
        {
            message = $"Could not load assessment: {ex.Message}";
        }
    }


    // Save changes to the existing assessment.
    private async Task HandleUpdateAssessment()
    {
        message = "";
        success = false;

        if (!AuthSession.IsAuthenticated)
        {
            message = "Please log in first.";
            return;
        }

        if (string.IsNullOrWhiteSpace(assessmentName) ||
            string.IsNullOrWhiteSpace(applicationName))
        {
            message = "Enter an assessment name and application name.";
            return;
        }

        if (endDate <= startDate)
        {
            message = "End date must be after start date.";
            return;
        }

        var roles = SplitValues(roleNames);

        var selectedRegions = regions
            .Where(r => r.Selected)
            .Select(r => r.RegionId)
            .ToList();

        var selectedExperiences = experiences
            .Where(e => e.Selected)
            .Select(e => e.ExperienceId)
            .ToList();

        if (roles.Count == 0 ||
            selectedRegions.Count == 0 ||
            selectedExperiences.Count == 0)
        {
            message = "Choose at least one role, region and experience level.";
            return;
        }

        if (string.IsNullOrWhiteSpace(AuthSession.CsrfToken))
        {
            message = "Your security token is missing. Please log in again.";
            return;
        }

        var payload = new
        {
            AssessmentName = assessmentName,
            ApplicationName = applicationName,

            StartDate = DateTime.SpecifyKind(
                startDate.Date, DateTimeKind.Utc),

            EndDate = DateTime.SpecifyKind(
                endDate.Date, DateTimeKind.Utc),

            RoleNames = roles,
            RegionIds = selectedRegions,
            ExperienceIds = selectedExperiences,
            RespondentEmails = SplitValues(respondentEmails)
        };

        isSaving = true;

        try
        {
            var client = HttpClientFactory.CreateClient("ADAApi");

            using var request = new HttpRequestMessage(
                HttpMethod.Put,
                $"api/assessments/{AssessmentId}");

            // Send the authentication cookie.
            AddSessionCookie(request);

            // Send the CSRF token.
            request.Headers.Add(
                "X-CSRF-TOKEN",
                AuthSession.CsrfToken);

            request.Content = JsonContent.Create(payload);

            using var response = await client.SendAsync(request);

            UpdateCookies(response);

            if (response.IsSuccessStatusCode)
            {
                success = true;
                message = "Assessment updated successfully!";

                await Task.Delay(1000);
                Navigation.NavigateTo("/assessments");
            }
            else if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                message = "You need the Admin role to edit assessments.";
            }
            else if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                message = "Your session has expired. Please log in again.";
            }
            else if (response.StatusCode == HttpStatusCode.BadRequest)
            {
                var error = await response.Content.ReadAsStringAsync();
                message = $"Request rejected: {error}";
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                message = $"API error ({(int)response.StatusCode}): {error}";
            }
        }
        catch (Exception ex)
        {
            message = $"Error: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }


    // Attach the stored authentication cookie to a request.
    private void AddSessionCookie(HttpRequestMessage request)
    {
        if (!string.IsNullOrWhiteSpace(AuthSession.CookieHeader))
        {
            request.Headers.TryAddWithoutValidation(
                "Cookie",
                AuthSession.CookieHeader);
        }
    }


    // Update stored cookies if the backend sends new ones.
    private void UpdateCookies(HttpResponseMessage response)
    {
        if (!response.Headers.TryGetValues(
            "Set-Cookie", out var setCookieHeaders))
        {
            return;
        }

        var cookies = new Dictionary<string, string>(
            StringComparer.OrdinalIgnoreCase);

        if (!string.IsNullOrWhiteSpace(AuthSession.CookieHeader))
        {
            foreach (var cookie in AuthSession.CookieHeader.Split(
                ';', StringSplitOptions.RemoveEmptyEntries))
            {
                var parts = cookie.Trim().Split('=', 2);

                if (parts.Length == 2)
                    cookies[parts[0]] = parts[1];
            }
        }

        foreach (var setCookie in setCookieHeaders)
        {
            var cookiePair = setCookie.Split(';', 2)[0].Trim();
            var parts = cookiePair.Split('=', 2);

            if (parts.Length == 2)
                cookies[parts[0]] = parts[1];
        }

        AuthSession.CookieHeader = string.Join(
            "; ",
            cookies.Select(cookie =>
                $"{cookie.Key}={cookie.Value}"));
    }


    private static List<string> SplitValues(string input)
    {
        return input.Split(
                new[] { ',', ';', '\n', '\r' },
                StringSplitOptions.RemoveEmptyEntries |
                StringSplitOptions.TrimEntries)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }


    private void GoBack()
    {
        Navigation.NavigateTo("/assessments");
    }


    private void CloseMessage()
    {
        message = "";
    }


    private class RegionOption
    {
        public Guid RegionId { get; set; }
        public string RegionName { get; set; } = "";
        public bool Selected { get; set; }
    }


    private class ExperienceOption
    {
        public Guid ExperienceId { get; set; }
        public string ExperienceValue { get; set; } = "";
        public bool Selected { get; set; }
    }


    // Matches the response from GetAssessmentDetailsResponse.
    private class AssessmentDetailsResponse
    {
        public Guid AssessmentId { get; set; }
        public string AssessmentName { get; set; } = "";
        public string ApplicationName { get; set; } = "";
        public DateTime StartDate { get; set; }
        public DateTime EndDate { get; set; }
        public List<string> RoleNames { get; set; } = new();
        public List<Guid> RegionIds { get; set; } = new();
        public List<Guid> ExperienceIds { get; set; } = new();
        public List<string> RespondentEmails { get; set; } = new();
    }
}
