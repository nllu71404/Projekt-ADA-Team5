@page "/surveys"
@page "/survey"
@rendermode InteractiveServer

@using ADA.Frontend.Services
@using System.Net.Http.Json

@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@inject AuthSession AuthSession

<PageTitle>Answer Survey</PageTitle>

<div class="container py-4" style="max-width: 900px">

    <h1>Answer Survey</h1>

   
    @if (isLoading)
    {
        <p>Loading survey...</p>
    }
    else if (submitted)
    {
        <div class="alert alert-success mt-4">
            Thank you! Your answers have been submitted.
        </div>
    }
    else if (survey is not null)
    {
        <!-- Survey information -->
        <div class="mt-4 mb-4">
            <h2>@survey.SurveyTitle</h2>
            <p class="text-muted">
                Assessment: @survey.AssessmentName
            </p>
            <p>@survey.SurveyDescription</p>
        </div>

        <!-- Respondent information -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">

                <h4>About you</h4>

                <div class="row g-3">

                    <!-- Role -->
                    <div class="col-md-4">
                        <label class="form-label">Role</label>

                        <select class="form-select" @bind="roleId">
                            <option value="@Guid.Empty">
                                Select role
                            </option>

                            @foreach (var role in survey.Roles)
                            {
                                <option value="@role.RoleId">
                                    @role.RoleName
                                </option>
                            }
                        </select>
                    </div>

                    <!-- Region -->
                    <div class="col-md-4">
                        <label class="form-label">Region</label>

                        <select class="form-select" @bind="regionId">
                            <option value="@Guid.Empty">
                                Select region
                            </option>

                            @foreach (var region in survey.Regions)
                            {
                                <option value="@region.RegionId">
                                    @region.RegionName
                                </option>
                            }
                        </select>
                    </div>

                    <!-- Experience -->
                    <div class="col-md-4">
                        <label class="form-label">Experience</label>

                        <select class="form-select" @bind="experienceId">
                            <option value="@Guid.Empty">
                                Select experience
                            </option>

                            @foreach (var experience in survey.Experiences)
                            {
                                <option value="@experience.ExperienceId">
                                    @experience.ExperienceValue
                                </option>
                            }
                        </select>
                    </div>

                </div>
            </div>
        </div>

        <!-- Themes and questions -->
        @foreach (var theme in survey.Themes)
        {
            <div class="card shadow-sm mb-4"
                 @key="theme.ThemeId">

                <div class="card-body">

                    <h4>@theme.Title</h4>

                    <p class="text-muted">
                        @theme.Description
                    </p>

                    @foreach (var question in theme.Questions)
                    {
                        <fieldset class="border-top pt-3 mt-3"
                                  @key="question.QuestionId">

                            <legend class="fs-6 fw-semibold">
                                @question.QuestionText
                            </legend>

                            <div class="d-flex flex-wrap gap-3 mt-2">

                                @foreach (var point in question.AnswerOptions)
                                {
                                    <label class="form-check form-check-inline">

                                        <input type="radio"
                                               class="form-check-input"
                                               name="@($"question-{question.QuestionId:N}")"
                                               value="@point"
                                               checked="@(answers.TryGetValue(question.QuestionId, out var chosen) && chosen == point)"
                                               @onchange="_ => SetAnswer(question.QuestionId, point)" />

                                        <span class="form-check-label">
                                            @point
                                        </span>

                                    </label>
                                }

                            </div>
                        </fieldset>
                    }

                    <!-- Optional comment -->
                    <div class="mt-3">

                        <label class="form-label">
                            Comment (optional)
                        </label>

                        <textarea class="form-control"
                                  rows="3"
                                  @oninput="e => SetComment(theme.ThemeId, e.Value?.ToString() ?? string.Empty)">
                        </textarea>

                    </div>

                </div>
            </div>
        }

        <!-- Error -->
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger">
                @errorMessage
            </div>
        }

        <!-- Submit -->
        <button class="btn btn-success btn-lg"
                disabled="@isSubmitting"
                @onclick="SubmitAsync">

            @(isSubmitting ? "Submitting..." : "Submit Survey")

        </button>
    }

    @if (survey is null &&
         !isLoading &&
         !submitted &&
         !string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger mt-4">
            @errorMessage
        </div>
    }

</div>

@code {
    private SurveyResponseDto? survey;

    private readonly Dictionary<Guid, int> answers = new();
    private readonly Dictionary<Guid, string> comments = new();

    private Guid roleId = Guid.Empty;
    private Guid regionId = Guid.Empty;
    private Guid experienceId = Guid.Empty;

    private bool isLoading = true;
    private bool isSubmitting = false;
    private bool submitted = false;

    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // 1. Hent magic link-token fra URL'en
            var uri = Navigation.ToAbsoluteUri(Navigation.Uri);

            var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers
                .ParseQuery(uri.Query);

            if (!query.TryGetValue("token", out var token) ||
                string.IsNullOrWhiteSpace(token))
            {
                errorMessage = "Der blev ikke fundet et token i linket.";
                return;
            }

            var client = HttpClientFactory.CreateClient("ADAApi");

            // 2. Hent CSRF-token før login
            var csrfToken = await FetchCsrfTokenAsync(client);

            if (string.IsNullOrWhiteSpace(csrfToken))
            {
                errorMessage = "Kunne ikke hente CSRF-token.";
                return;
            }

            // 3. Udveksl magic link-tokenet til en respondent-cookie
            using var request = new HttpRequestMessage(
                HttpMethod.Post,
                "api/respondents/exchange-magic-link");

            request.Headers.TryAddWithoutValidation(
                "X-CSRF-TOKEN",
                csrfToken);

            AddSessionCookie(request);

            request.Content = JsonContent.Create(new
            {
                Token = token.ToString()
            });

            using var response = await client.SendAsync(request);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage =
                    $"Login mislykkedes. Statuskode: {(int)response.StatusCode}";

                return;
            }

            // 4. Gem respondent-cookien
            UpdateCookies(response);

            // 5. Hent nyt CSRF-token efter login
            var authenticatedCsrfToken =
                await FetchCsrfTokenAsync(client);

            if (string.IsNullOrWhiteSpace(authenticatedCsrfToken))
            {
                errorMessage =
                    "Login lykkedes, men kunne ikke hente nyt CSRF-token.";

                return;
            }

            AuthSession.CsrfToken = authenticatedCsrfToken;
            AuthSession.NotifyChanged();

            // 6. Kontrollér at respondent-cookien er gemt
            if (!AuthSession.IsRespondentAuthenticated)
            {
                errorMessage =
                    "Login lykkedes, men respondent-cookien blev ikke registreret.";

                return;
            }

            // 7. Hent surveyen via den autentificerede session
            using var surveyRequest = new HttpRequestMessage(
                HttpMethod.Get,
                "api/respondents/survey");

            AddSessionCookie(surveyRequest);

            using var surveyResponse =
                await client.SendAsync(surveyRequest);

            if (!surveyResponse.IsSuccessStatusCode)
            {
                errorMessage =
                    "Surveyen kunne ikke hentes. Den er muligvis lukket eller allerede besvaret.";

                return;
            }

            survey = await surveyResponse.Content
                .ReadFromJsonAsync<SurveyResponseDto>();

            if (survey is null)
            {
                errorMessage = "Kunne ikke indlæse surveyen.";
                return;
            }

            // // 8. Fjern magic link-tokenet fra adresselinjen
            // Navigation.NavigateTo("/survey", replace: true);
        }
        catch (HttpRequestException)
        {
            errorMessage = "Kunne ikke oprette forbindelse til backend API'et.";
        }
        catch (System.Text.Json.JsonException)
        {
            errorMessage = "Backend returnerede et ugyldigt svar.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Der opstod en fejl: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    // Henter CSRF-token og opdaterer cookies
    private async Task<string?> FetchCsrfTokenAsync(HttpClient client)
    {
        using var request = new HttpRequestMessage(
            HttpMethod.Get,
            "api/auth/csrf-token");

        AddSessionCookie(request);

        using var response = await client.SendAsync(request);

        if (!response.IsSuccessStatusCode)
            return null;

        UpdateCookies(response);

        var csrfData = await response.Content
            .ReadFromJsonAsync<CsrfResponse>();

        return csrfData?.RequestToken;
    }

    // Tilføjer den gemte session-cookie til en request
    private void AddSessionCookie(HttpRequestMessage request)
    {
        if (!string.IsNullOrWhiteSpace(AuthSession.CookieHeader))
        {
            request.Headers.TryAddWithoutValidation(
                "Cookie",
                AuthSession.CookieHeader);
        }
    }

    // Gemmer cookies fra backend
    private void UpdateCookies(HttpResponseMessage response)
    {
        if (!response.Headers.TryGetValues(
            "Set-Cookie", out var setCookieHeaders))
        {
            return;
        }

        var cookies = new Dictionary<string, string>(
            StringComparer.OrdinalIgnoreCase);

        if (!string.IsNullOrWhiteSpace(AuthSession.CookieHeader))
        {
            foreach (var cookie in AuthSession.CookieHeader.Split(
                ';', StringSplitOptions.RemoveEmptyEntries))
            {
                var parts = cookie.Trim().Split('=', 2);

                if (parts.Length == 2)
                    cookies[parts[0]] = parts[1];
            }
        }

        foreach (var setCookie in setCookieHeaders)
        {
            var cookiePair = setCookie.Split(';', 2)[0].Trim();
            var parts = cookiePair.Split('=', 2);

            if (parts.Length == 2)
                cookies[parts[0]] = parts[1];
        }

        AuthSession.CookieHeader = string.Join(
            "; ",
            cookies.Select(cookie =>
                $"{cookie.Key}={cookie.Value}"));
    }

    // Gemmer respondentens valgte svar
    private void SetAnswer(Guid questionId, int point)
    {
        answers[questionId] = point;
    }

    // Gemmer respondentens kommentar
    private void SetComment(Guid themeId, string value)
    {
        comments[themeId] = value;
    }

    // Indsender besvarelsen
    private async Task SubmitAsync()
    {
        if (survey is null)
            return;

        errorMessage = string.Empty;

        var questions = survey.Themes
            .SelectMany(t => t.Questions)
            .ToList();

        // Kontrollér respondentens oplysninger
        if (roleId == Guid.Empty ||
            regionId == Guid.Empty ||
            experienceId == Guid.Empty)
        {
            errorMessage =
                "Please select role, region and experience.";

            return;
        }

        // Kontrollér at alle spørgsmål er besvaret
        if (questions.Count == 0 ||
            questions.Any(q => !answers.ContainsKey(q.QuestionId)))
        {
            errorMessage = "Please answer every question.";
            return;
        }

        if (string.IsNullOrWhiteSpace(AuthSession.CsrfToken) ||
            !AuthSession.IsRespondentAuthenticated)
        {
            errorMessage = "Your session has expired. Please open your survey link again.";
            return;
        }

        isSubmitting = true;

        try
        {
            // Byg request uden magic link-token
            var requestBody = new
            {
                RoleId = roleId,
                RegionId = regionId,
                ExperienceId = experienceId,

                Answers = questions.Select(q => new
                {
                    QuestionId = q.QuestionId,
                    Point = answers[q.QuestionId]
                }).ToList(),

                Comments = survey.Themes
                    .Where(t =>
                        comments.TryGetValue(t.ThemeId, out var text) &&
                        !string.IsNullOrWhiteSpace(text))
                    .Select(t => new
                    {
                        ThemeId = t.ThemeId,
                        FreeForm = comments[t.ThemeId]
                    }).ToList()
            };

            var client = HttpClientFactory.CreateClient("ADAApi");

            using var request = new HttpRequestMessage(
                HttpMethod.Post,
                "api/respondents/survey/submit");

            request.Headers.TryAddWithoutValidation(
                "X-CSRF-TOKEN",
                AuthSession.CsrfToken);

            AddSessionCookie(request);

            request.Content = JsonContent.Create(requestBody);

            using var response = await client.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                submitted = true;
                survey = null;
            }
            else
            {
                errorMessage =
                    $"Submission failed (HTTP {(int)response.StatusCode}). " +
                    "Check your answers or survey access.";
            }
        }
        catch (HttpRequestException)
        {
            errorMessage = "Could not connect to the backend API.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private record CsrfResponse(string RequestToken);
}