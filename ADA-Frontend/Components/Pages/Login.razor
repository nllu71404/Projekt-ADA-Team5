@page "/login"
@rendermode InteractiveServer
@using System.Net.Http.Json
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@using ADA.Frontend.Services
@inject AuthSession AuthSession
@inject NavigationManager Navigation



<h3>ADA Login</h3>

<div class="mb-3">
    <label>Email</label>
    <input class="form-control" type="email" @bind="email" />
</div>

<div class="mb-3">
    <label>Password</label>
    <input class="form-control" type="password" @bind="password" />
</div>

<button class="btn btn-primary" @onclick="HandleLogin">
    Login
</button>

<p class="mt-3">@message</p>

@code {
    private string email = "";
    private string password = "";
    private string message = "";

    private async Task HandleLogin()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("ADAApi");

            var response = await client.PostAsJsonAsync(
                "api/auth/login",
                new { Email = email, Password = password });

            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content
                    .ReadFromJsonAsync<LoginResponse>();

                if (!string.IsNullOrEmpty(result?.AccessToken))
                {
                    AuthSession.AccessToken = result.AccessToken;

                    Navigation.NavigateTo("/dashboard");
                    return;
                }

                message = "No token received.";
            }

            else
            {
                message = "Invalid email or password.";
            }
        }
        catch (Exception ex)
        {
            message = $"Error: {ex.Message}";
        }
    }

    private record LoginResponse(string AccessToken);
}
