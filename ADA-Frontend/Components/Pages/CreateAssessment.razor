@page "/assessments/create"

@using System.Net.Http.Headers
@using System.Net.Http.Json
@using ADA.Frontend.Services

@inject IHttpClientFactory HttpClientFactory
@inject AuthSession AuthSession

<PageTitle>Create Assessment</PageTitle>

<div class="container py-4">

    <h2>Create Assessment</h2>
    <p class="text-muted">
        Create a new ADA assessment.
    </p>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert @(success ? "alert-success" : "alert-danger")">
            @message
        </div>
    }

    @if (string.IsNullOrEmpty(AuthSession.AccessToken))
    {
        <div class="alert alert-warning">
            Please <a href="/login">log in</a> first.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">

                <div class="mb-3">
                    <label class="form-label">Assessment Name</label>
                    <input class="form-control"
                           @bind="assessmentName"
                           placeholder="e.g. Employee Assessment 2026" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Application Name</label>
                    <input class="form-control"
                           @bind="applicationName"
                           placeholder="e.g. Microsoft Teams" />
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Start Date</label>
                        <input type="date"
                               class="form-control"
                               @bind="startDate" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">End Date</label>
                        <input type="date"
                               class="form-control"
                               @bind="endDate" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Roles</label>
                    <input class="form-control"
                           @bind="roleNames"
                           placeholder="Developer, Manager, Consultant" />
                    <small class="text-muted">
                        Separate roles with commas.
                    </small>
                </div>

                <hr />

                <h5>Regions</h5>

                @foreach (var region in regions)
                {
                    <div class="form-check" @key="region.RegionId">
                        <input type="checkbox"
                               class="form-check-input"
                               @bind="region.Selected" />
                        <label class="form-check-label">
                            @region.RegionName
                        </label>
                    </div>
                }

                <hr />

                <h5>Experience Levels</h5>

                @foreach (var experience in experiences)
                {
                    <div class="form-check" @key="experience.ExperienceId">
                        <input type="checkbox"
                               class="form-check-input"
                               @bind="experience.Selected" />
                        <label class="form-check-label">
                            @experience.ExperienceValue
                        </label>
                    </div>
                }

                <hr />

                <div class="mb-3">
                    <label class="form-label">Respondent Emails</label>
                    <textarea class="form-control"
                              rows="4"
                              @bind="respondentEmails"
                              placeholder="person1@example.com&#10;person2@example.com">
                    </textarea>
                    <small class="text-muted">
                        One email per line.
                    </small>
                </div>

                <button class="btn btn-primary"
                        disabled="@isSaving"
                        @onclick="HandleCreateAssessment">
                    @(isSaving ? "Creating..." : "Create Assessment")
                </button>

                <a href="/dashboard"
                   class="btn btn-outline-secondary ms-2">
                    Cancel
                </a>

            </div>
        </div>
    }
</div>

@code {

    private string assessmentName = "";
    private string applicationName = "";
    private string roleNames = "";
    private string respondentEmails = "";

    private DateTime startDate = DateTime.Today;
    private DateTime endDate = DateTime.Today.AddDays(14);

    private List<RegionOption> regions = new();
    private List<ExperienceOption> experiences = new();

    private string message = "";
    private bool success;
    private bool isSaving;

    private static readonly Guid SurveyId =
        Guid.Parse("22222222-2222-2222-2222-222222222222");

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(AuthSession.AccessToken))
            return;

        try
        {
            var client = HttpClientFactory.CreateClient("ADAApi");

            using var regionRequest =
                new HttpRequestMessage(HttpMethod.Get, "api/regions");

            regionRequest.Headers.Authorization =
                new AuthenticationHeaderValue(
                    "Bearer", AuthSession.AccessToken);

            using var regionResponse =
                await client.SendAsync(regionRequest);

            regionResponse.EnsureSuccessStatusCode();

            regions = await regionResponse.Content
                .ReadFromJsonAsync<List<RegionOption>>() ?? new();

            using var experienceRequest =
                new HttpRequestMessage(HttpMethod.Get, "api/experiences");

            experienceRequest.Headers.Authorization =
                new AuthenticationHeaderValue(
                    "Bearer", AuthSession.AccessToken);

            using var experienceResponse =
                await client.SendAsync(experienceRequest);

            experienceResponse.EnsureSuccessStatusCode();

            experiences = await experienceResponse.Content
                .ReadFromJsonAsync<List<ExperienceOption>>() ?? new();
        }
        catch (Exception ex)
        {
            message = $"Could not load options: {ex.Message}";
        }
    }

    private async Task HandleCreateAssessment()
    {
        message = "";
        success = false;

        if (string.IsNullOrWhiteSpace(assessmentName) ||
            string.IsNullOrWhiteSpace(applicationName))
        {
            message = "Enter an assessment name and application name.";
            return;
        }

        if (endDate <= startDate)
        {
            message = "End date must be after start date.";
            return;
        }

        var roles = SplitValues(roleNames);

        var selectedRegions = regions
            .Where(r => r.Selected)
            .Select(r => r.RegionId)
            .ToList();

        var selectedExperiences = experiences
            .Where(e => e.Selected)
            .Select(e => e.ExperienceId)
            .ToList();

        if (roles.Count == 0 ||
            selectedRegions.Count == 0 ||
            selectedExperiences.Count == 0)
        {
            message = "Choose at least one role, region and experience level.";
            return;
        }

        
        var payload = new
        {
            AssessmentName = assessmentName,
            ApplicationName = applicationName,

            StartDate = DateTime.SpecifyKind(
                startDate.Date, DateTimeKind.Utc),

            EndDate = DateTime.SpecifyKind(
                endDate.Date, DateTimeKind.Utc),

            SurveyId = SurveyId,
            RoleNames = roles,
            RegionIds = selectedRegions,
            ExperienceIds = selectedExperiences,
            RespondentEmails = SplitValues(respondentEmails)
        };


        isSaving = true;

        try
        {
            var client = HttpClientFactory.CreateClient("ADAApi");

            using var request = new HttpRequestMessage(
                HttpMethod.Post, "api/assessments");

            request.Headers.Authorization =
                new AuthenticationHeaderValue(
                    "Bearer", AuthSession.AccessToken);

            request.Content = JsonContent.Create(payload);

            using var response = await client.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                var id = await response.Content.ReadFromJsonAsync<Guid>();

                success = true;
                message = $"Assessment created successfully! ID: {id}";
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                message = "You need the Admin role to create assessments.";
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                message = "Your login has expired. Please log in again.";
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                message = $"API error ({(int)response.StatusCode}): {error}";
            }
        }
        catch (Exception ex)
        {
            message = $"Error: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private static List<string> SplitValues(string input)
    {
        return input.Split(
                new[] { ',', ';', '\n', '\r' },
                StringSplitOptions.RemoveEmptyEntries |
                StringSplitOptions.TrimEntries)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private class RegionOption
    {
        public Guid RegionId { get; set; }
        public string RegionName { get; set; } = "";
        public bool Selected { get; set; }
    }

    private class ExperienceOption
    {
        public Guid ExperienceId { get; set; }
        public string ExperienceValue { get; set; } = "";
        public bool Selected { get; set; }
    }
}
