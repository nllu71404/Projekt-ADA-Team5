@page "/dashboard"

@using ADA.Frontend.Components.Buttons



<PageTitle>ADA management system</PageTitle>

<div class="container py-4">

    <!-- Header -->
    <div class="mb-4 d-flex justify-content-between align-items-center">
        <div>
            <h1 class="fw-bold">ADA managament system</h1>
           
        </div>

         <LogoutButton />
    </div>

    

    <!-- Dashboard cards -->
    <div class="row g-4">

        <!-- Assessments -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h4 class="card-title">Assessments</h4>

                    <p class="card-text text-muted">
                        Create and manage assessments
                        for your applications.
                    </p>

                    <a href="/assessments/create" class="btn btn-primary">
                        Create Assessment
                    </a>
                    <a href="/assessments" class="btn btn-primary">
                        View and manage Assessments
                    </a>
                </div>
            </div>
        </div>

        <!-- Surveys -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h4 class="card-title">Surveys</h4>

                    <p class="card-text text-muted">
                        View surveys and their questions
                        and responses.
                    </p>

                    <button class="btn btn-primary" disabled>
                        View Surveys
                    </button>
                </div>
            </div>
        </div>

        <!-- Regions & Experiences -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h4 class="card-title">
                        Regions & Experiences
                    </h4>

                    <p class="card-text text-muted">
                        View available regions and
                        experience levels.
                    </p>

                    <button class="btn btn-primary" disabled>
                        View Data
                    </button>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h4 class="card-title">Audit History</h4>

                    <p class="card-text text-muted">
                        See who changed your company's assessments, what changed,
                        and when.
                    </p>

                    <a href="/audit-history" class="btn btn-primary">
                        View Audit History
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h4 class="card-title">Contact Directory</h4>

                    <p class="card-text text-muted">
                        View and filter your company’s contacts, or import contacts from a CSV.
                    </p>

                    <a href="/contacts" class="btn btn-primary">
                        View Contacts
                    </a>

                    <a href="/email-lists/import" class="btn btn-outline-primary">
                        Import Contacts
                    </a>
                </div>
            </div>
        </div>


    </div>
</div>

