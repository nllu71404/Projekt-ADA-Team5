@page "/login"
@rendermode InteractiveServer
@using System.Net.Http.Json
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@using ADA.Frontend.Services
@inject AuthSession AuthSession
@inject NavigationManager Navigation



<h3>ADA Login</h3>

<div class="mb-3">
    <label>Email</label>
    <input class="form-control" type="email" @bind="email" />
</div>

<div class="mb-3">
    <label>Password</label>
    <input class="form-control" type="password" @bind="password" />
</div>

<button class="btn btn-primary" @onclick="HandleLogin">
    Login
</button>

<p class="mt-3">@message</p>

@code {
    private string email = "";
    private string password = "";
    private string message = "";

    private async Task HandleLogin()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("ADAApi");

            // 1. Hent CSRF-token fra backend.
            using var csrfResponse = await client.GetAsync(
                "api/auth/csrf-token");

            if (!csrfResponse.IsSuccessStatusCode)
            {
                message = "Could not retrieve CSRF token.";
                return;
            }

            // Gem antiforgery-cookien fra backend.
            UpdateCookies(csrfResponse);

            var csrfData = await csrfResponse.Content
                .ReadFromJsonAsync<CsrfResponse>();

            if (string.IsNullOrWhiteSpace(csrfData?.RequestToken))
            {
                message = "No CSRF token received.";
                return;
            }

            AuthSession.CsrfToken = csrfData.RequestToken;

            // 2. Send login-request med CSRF-token og cookie.
            using var loginRequest = new HttpRequestMessage(
                HttpMethod.Post,
                "api/auth/web-login");

            loginRequest.Headers.Add(
                "X-CSRF-TOKEN",
                AuthSession.CsrfToken);

            if (!string.IsNullOrWhiteSpace(AuthSession.CookieHeader))
            {
                loginRequest.Headers.Add(
                    "Cookie",
                    AuthSession.CookieHeader);
            }

            loginRequest.Content = JsonContent.Create(new
            {
                Email = email,
                Password = password
            });

            using var loginResponse = await client.SendAsync(loginRequest);

            if (loginResponse.IsSuccessStatusCode)
            {
                // 3. Gem authentication-cookien fra backend.
                UpdateCookies(loginResponse);

                if (AuthSession.IsAuthenticated)
                {
                    Navigation.NavigateTo("/dashboard");
                    return;
                }

                message = "Login succeeded, but no authentication cookie was received.";
                return;
            }

            message = loginResponse.StatusCode == System.Net.HttpStatusCode.BadRequest
                ? "Login request was rejected. Check the CSRF token."
                : "Invalid email or password.";
        }
        catch (Exception ex)
        {
            message = $"Error: {ex.Message}";
        }
    }

    // Gemmer cookies fra backend uden deres øvrige attributter.
    private void UpdateCookies(HttpResponseMessage response)
    {
        if (!response.Headers.TryGetValues(
            "Set-Cookie", out var setCookieHeaders))
        {
            return;
        }

        var cookies = new Dictionary<string, string>(
            StringComparer.OrdinalIgnoreCase);

        // Behold allerede modtagne cookies.
        if (!string.IsNullOrWhiteSpace(AuthSession.CookieHeader))
        {
            foreach (var cookie in AuthSession.CookieHeader.Split(
                ';', StringSplitOptions.RemoveEmptyEntries))
            {
                var parts = cookie.Trim().Split('=', 2);

                if (parts.Length == 2)
                    cookies[parts[0]] = parts[1];
            }
        }

        // Opdater med cookies fra det aktuelle svar.
        foreach (var setCookie in setCookieHeaders)
        {
            var cookiePair = setCookie.Split(';', 2)[0].Trim();
            var parts = cookiePair.Split('=', 2);

            if (parts.Length == 2)
                cookies[parts[0]] = parts[1];
        }

        AuthSession.CookieHeader = string.Join(
            "; ",
            cookies.Select(cookie => $"{cookie.Key}={cookie.Value}"));
    }

    private record CsrfResponse(string RequestToken);
}
